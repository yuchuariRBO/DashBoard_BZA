[Unit]
Description=Bonanza private Prometheus
After=network-online.target nginx.service bonanza-gunicorn.service
Wants=network-online.target
[Service]
User=bonanza-monitor
Group=bonanza-monitor
UMask=0027
ExecStart=/opt/bonanza-observability/prometheus/prometheus --config.file=/etc/bonanza-observability/prometheus.yml --storage.tsdb.path=/var/lib/bonanza-observability/prometheus --storage.tsdb.retention.time=15d --storage.tsdb.retention.size=512MB --web.listen-address=127.0.0.1:19090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bonanza-observability/prometheus
[Install]
WantedBy=multi-user.target
