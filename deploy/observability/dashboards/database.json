{
  "uid": "bonanza-database",
  "title": "Bonanza · Base de datos",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "bonanza"
  ],
  "timezone": "America/Guayaquil",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad (SELECT 1)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bonanza_database_available",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Consultas SQL por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bonanza_db_query_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "SQL P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(bonanza_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Consultas lentas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bonanza_db_slow_queries_total[5m]))",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Errores SQL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bonanza_db_errors_total[5m]))",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "SQL por operación",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bonanza-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation)(rate(bonanza_db_query_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}{{status}}{{priority}}{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Alcance de las mediciones",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "**Motor actual: SQLite.** No expone conexiones activas/disponibles, pool, esperas y bloqueos globales ni saturación de servidor. La duración mide execute/executemany, no consumo del cursor ni duración completa de transacciones. No se ejecutan scans de monitoreo SQL ni PRAGMA costosos. Si se migra a PostgreSQL, configurar postgres_exporter con credenciales de lectura y paneles específicos antes de anunciar esas métricas."
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
