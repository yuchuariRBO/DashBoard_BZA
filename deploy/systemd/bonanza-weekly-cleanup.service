[Unit]
Description=Bonanza - limpieza semanal acotada de la VM
Documentation=file:/root/bonanza/docs/operations/weekly-cleanup.md
After=local-fs.target
ConditionPathIsDirectory=/root/bonanza

[Service]
Type=oneshot
User=root
Group=robiotec
UMask=0027
ExecStart=/usr/bin/python3 -B /root/bonanza/deploy/scripts/weekly_cleanup.py
WorkingDirectory=/root/bonanza
RuntimeDirectory=bonanza-maintenance
RuntimeDirectoryMode=0700
TimeoutStartSec=20min
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/root/bonanza/logs
ReadWritePaths=/var/cache/apt /var/lib/apt /var/lib/logrotate
ReadWritePaths=-/var/log/journal -/run/log/journal -/var/log/apt
ReadWritePaths=-/root/.cache/pip -/home/robiotec/.cache/pip
ReadWritePaths=-/root/.vscode-server/data/CachedExtensionVSIXs
ReadWritePaths=-/home/robiotec/.vscode-server/data/CachedExtensionVSIXs
StandardOutput=journal
StandardError=journal
