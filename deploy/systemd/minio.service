[Unit]
Description=MinIO object storage for Bonanza Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root
EnvironmentFile=/root/bonanza/.env
ExecStart=/usr/local/bin/minio server /root/bonanza/MinIO --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
